# SMTP credentials for outbound transactional email (template).
# Copy to .env (gitignored) and fill in the real password.
#
# Mail is sent AS no-reply@<domain> THROUGH the SGC mailcow (mail.yeet.fm),
# which is the SPF-authorized MX and DKIM-signs the message, so it passes
# SPF + DKIM + DMARC. Do NOT send directly from the app host (fails SPF).
#
# Deployment source of truth is the SGC playbook host_vars/vault.yml
# (vault_bskypds_smtp_password); this .env is for local reference/testing.

# --- mailcow submission endpoint (generic form) ---
SMTP_HOST=mail.yeet.fm
SMTP_PORT=587
SMTP_USERNAME=no-reply@bskypds.pro
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@bskypds.pro
SMTP_TLS=starttls

# --- @atproto/pds form (PDS_EMAIL_SMTP_URL uses implicit TLS on 465) ---
PDS_EMAIL_SMTP_URL=smtps://no-reply%40bskypds.pro:CHANGE_ME@mail.yeet.fm:465/
PDS_EMAIL_FROM_ADDRESS=no-reply@bskypds.pro
